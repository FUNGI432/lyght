<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Device switcher -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/deviceChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="8dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="@string/status_disconnected" />

            <!-- Hero: live color + power -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp">

                        <View
                            android:id="@+id/colorPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#FFFFFF" />

                        <ImageButton
                            android:id="@+id/powerButton"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="18dp"
                            android:background="@drawable/bg_power_button"
                            android:src="@drawable/ic_power"
                            android:contentDescription="@string/label_power" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/colorModeToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/colorModeButton"
                                style="@style/ModeToggleButton"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/mode_color" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/whiteModeButton"
                                style="@style/ModeToggleButton"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/mode_white" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <!-- Color mode sliders -->
                        <LinearLayout
                            android:id="@+id/colorSliders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <TextView style="@style/SliderLabel" android:text="@string/label_hue" android:paddingBottom="2dp" />
                            <SeekBar android:id="@+id/hueSeek" style="@style/GradientSlider" android:max="360" />

                            <TextView style="@style/SliderLabel" android:text="@string/label_saturation" android:paddingTop="10dp" android:paddingBottom="2dp" />
                            <SeekBar android:id="@+id/saturationSeek" style="@style/GradientSlider" android:max="100" />
                        </LinearLayout>

                        <!-- White mode sliders -->
                        <LinearLayout
                            android:id="@+id/whiteSliders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginTop="16dp">

                            <TextView style="@style/SliderLabel" android:text="@string/label_warm" android:paddingBottom="2dp" />
                            <SeekBar android:id="@+id/warmSeek" style="@style/PlainSlider" />

                            <TextView style="@style/SliderLabel" android:text="@string/label_cold" android:paddingTop="10dp" android:paddingBottom="2dp" />
                            <SeekBar android:id="@+id/coldSeek" style="@style/PlainSlider" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp">

                            <TextView style="@style/SliderLabel" android:text="@string/section_brightness" android:layout_weight="1" android:layout_width="0dp" />
                            <TextView android:id="@+id/brightnessValue" style="@style/ValueLabel" android:text="0%" />
                        </LinearLayout>
                        <SeekBar android:id="@+id/brightnessSeek" style="@style/PlainSlider" android:layout_marginTop="4dp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginTop="16dp">
                            <LinearLayout
                                android:id="@+id/swatchRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_scrollFlags="noScroll"
            app:tabIndicatorColor="@color/accent"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextColor="@color/text_secondary"
            app:tabTextAppearance="@style/TabTextAppearance"
            app:tabMode="fixed" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
